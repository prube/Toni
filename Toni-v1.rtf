\f0\b0\fs32 \cf5 \cb6 Man k\'f6nnte Northoff und Solms ungef\'e4hr so zusammenbauen:\cb1 \
\pard\pardeftab720\sa320\partightenfactor0

\f1\b \cf5 \cb6 Northoff liefert die B\'fchne
\f0\b0 \cb1 \
\pard\pardeftab720\partightenfactor0
\cf5 \cb6 Ein selbstorganisiertes System besitzt eine fortlaufende intrinsische Dynamik und ist zeitlich-r\'e4umlich mit K\'f6rper und Umwelt gekoppelt.\cb1 \
\pard\pardeftab720\sa80\partightenfactor0

